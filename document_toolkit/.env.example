# Generic chat-completions-compatible server; no company URL or credentials included.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional second-pass model; empty means use LLM_MODEL.
LLM_JUDGE_MODEL=
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_PROMPT_BUDGET_BYTES=30000
LLM_MAX_OUTPUT_TOKENS=4096
