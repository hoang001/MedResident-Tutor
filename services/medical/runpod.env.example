# Production model-service process environment, on the RunPod host only.
# Loaded automatically by start-runpod.sh from /workspace/secrets/medresident-serving.env.
# Set the same API key as backend. MODEL_SERVICE_API_KEY takes precedence;
# an existing MEDICAL_API_KEY is reused only when MODEL_SERVICE_API_KEY is unset/empty.
# Never commit real values. No separate Teaching key.
# Optional: select the persistent serving venv without activating it each session.
# MODEL_SERVICE_PYTHON=/workspace/venvs/medresident-serving/bin/python
# Optional if the key is already exported or passed to the startup command.
# MODEL_SERVICE_API_KEY='<SET_A_PRIVATE_SERVICE_KEY_AT_LEAST_16_CHARACTERS>'
MEDICAL_BASE_MODEL_PATH=/workspace/models/qwen3-4b-instruct-2507
MEDICAL_ADAPTER_PATH=/workspace/adapters/medical-v1
# Optional pinned SHA-256. Unset/empty hashes are computed from local artifacts.
# Provided hashes are always verified; mismatches/placeholder values fail startup.
# MEDICAL_ADAPTER_SHA256=
# MEDICAL_BASE_CONFIG_SHA256=
# MEDICAL_ADAPTER_CONFIG_SHA256=
TEACHING_BASE_MODEL_PATH=/workspace/models/qwen2.5-7b-instruct
TEACHING_ADAPTER_PATH=/workspace/adapters/teaching-v1
# TEACHING_ADAPTER_SHA256=
# TEACHING_BASE_CONFIG_SHA256=
# TEACHING_ADAPTER_CONFIG_SHA256=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
WEB_CONCURRENCY=1
# Default log: /workspace/outputs/model-service.log (startup appends, never truncates).
