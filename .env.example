APP_NAME=Medical Resident Learning Assistant
GOOGLE_CLIENT_ID=
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
POSTGRES_DB=medical_learning
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=local_development_password
DATABASE_URL=postgresql+asyncpg://medical_user:local_development_password@db:5432/medical_learning
JWT_SECRET_KEY=<SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
FILE_STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=10
LLM_PROVIDER=mock
LLM_BASE_URL=http://10.8.0.1:4000/v1
LLM_API_KEY=<TOI_SE_TU_DIEN>
LLM_MODEL=vtllm/gemma-4-26b
LLM_CHAT_ENDPOINT=/v1/chat/completions
LLM_MAX_ATTEMPTS=1
LLM_PROMPT_BUDGET_BYTES=70000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
EMBEDDING_PROVIDER=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=<SET_A_LOCAL_ADMIN_PASSWORD>
SEED_LEARNER_EMAIL=learner@example.local
SEED_LEARNER_PASSWORD=<SET_A_LOCAL_LEARNER_PASSWORD>


# Local practice orchestration; mock is permitted only in development.
PRACTICE_MOCK_SCENARIO=success
PRACTICE_TIMEOUT_SECONDS=90
# Optional, development only; default/mock/production timings stay unchanged.
# PRACTICE_RUNTIME_PROFILE=local
# PRACTICE_LOCAL_MEDICAL_READ_SECONDS=90
# PRACTICE_LOCAL_CONNECT_SECONDS=5
# PRACTICE_LOCAL_WRITE_SECONDS=10
# PRACTICE_LOCAL_POOL_SECONDS=5
# PRACTICE_LOCAL_DEADLINE_GRACE_SECONDS=5
# HTTP mode requires BOTH services. Secrets remain backend-only.


NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=<TOI_SE_TU_DIEN>
KNOWLEDGE_DATA_ROOT=/app/data
# Docker backend uses this host bridge; scripts continue to use NEO4J_URI above.
APP_NEO4J_URI=bolt://host.docker.internal:7687

# RunPod inference: fill URLs/keys/model aliases, then explicitly enable calls.
# PRACTICE_PROVIDER=http enables Medical -> Teaching (both must be ready).
# AUTHORING_PROVIDER=openai enables separate question authoring.
# MODEL_CALLS_ENABLED=true is required for remote inference.
# For custom APIs use *_API_FORMAT=service and origin URLs without /v1.
# Keys are independent: do not reuse legacy LLM/KG_LLM keys automatically.
MODEL_CALLS_ENABLED=false
PRACTICE_PROVIDER=mock
AUTHORING_PROVIDER=off
MEDICAL_API_FORMAT=openai
MEDICAL_SERVICE_URL=https://<MEDICAL_POD_ID>-8000.proxy.runpod.net/v1
MEDICAL_SERVICE_API_KEY=<DIEN_KEY_MEDICAL_RUNPOD>
MEDICAL_MODEL=medical-v1
TEACHING_API_FORMAT=openai
TEACHING_SERVICE_URL=https://<TEACHING_POD_ID>-8000.proxy.runpod.net/v1
TEACHING_SERVICE_API_KEY=<DIEN_KEY_TEACHING_RUNPOD>
TEACHING_MODEL=teaching-v1
AUTHORING_SERVICE_URL=https://<AUTHORING_POD_ID>-8000.proxy.runpod.net/v1
AUTHORING_SERVICE_API_KEY=<DIEN_KEY_AUTHORING_RUNPOD>
AUTHORING_MODEL=Qwen/Qwen3-4B-Instruct-2507
