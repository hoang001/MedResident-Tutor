  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main task action.",
      "html": "<button class=\"ds-primary\">Gửi câu trả lời</button>",
      "css": ".ds-primary{font:600 16px/1.4 \"Segoe UI\",Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:7px;text-decoration:none;cursor:pointer;transition:background-color .15s,border-color .15s;background:var(--navy,#142d4e);color:var(--surface,#fff)}.ds-primary:hover{background:var(--navy-deep,#10253f)}.ds-primary:focus-visible{outline:3px solid var(--focus,#0b7779);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative action or pagination.",
      "html": "<button class=\"ds-secondary\">Trang sau</button>",
      "css": ".ds-secondary{font:600 16px/1.4 \"Segoe UI\",Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:7px;text-decoration:none;cursor:pointer;transition:background-color .15s,border-color .15s;background:var(--surface,#fff);border-color:var(--line,#d9e2ec);color:var(--navy,#142d4e)}.ds-secondary:hover{background:var(--info-soft,#edf3fb);border-color:#a0b2c8}.ds-secondary:focus-visible{outline:3px solid var(--focus,#0b7779);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Source preview or recovery action.",
      "html": "<button class=\"ds-text\">Đọc toàn bộ đoạn trích</button>",
      "css": ".ds-text{font:600 16px/1.4 \"Segoe UI\",Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:7px;text-decoration:none;cursor:pointer;transition:background-color .15s,border-color .15s;padding:8px 4px;background:transparent;color:var(--accent,#0b7779)}.ds-text:hover{background:var(--soft,#eaf4f3);color:var(--accent-hover,#075f62)}.ds-text:focus-visible{outline:3px solid var(--focus,#0b7779);outline-offset:3px}"
    },
    {
      "name": "Labelled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label with the shared field boundary.",
      "html": "<label class=\"ds-label\" for=\"ds-search\">Tìm bài đã làm</label><input class=\"ds-input\" id=\"ds-search\" type=\"search\" placeholder=\"Nhập nội dung bài tập\"/>",
      "css": ".ds-label{display:block;margin-bottom:7px;font:600 16px/1.6 \"Segoe UI\",Arial,sans-serif;color:var(--ink,#1c3049)}.ds-input{width:100%;min-height:46px;padding:11px 12px;border:1px solid #a8b8ca;border-radius:7px;background:var(--surface,#fff);color:var(--ink,#1c3049);font:16px/1.6 \"Segoe UI\",Arial,sans-serif;caret-color:var(--accent,#0b7779)}.ds-input::placeholder{color:#667689}.ds-input:focus-visible{outline:3px solid var(--focus,#0b7779);outline-offset:3px}.ds-input[aria-invalid=true]{border:2px solid var(--danger,#a02836)}"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "nav-current",
      "description": "Role navigation with current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng học tập\"><a href=\"#\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z\"/></svg>Tổng quan</a></nav>",
      "css": ".ds-nav{padding:16px;background:var(--navy,#142d4e)}.ds-nav a{display:flex;align-items:center;gap:12px;min-height:46px;padding:10px 12px;border-radius:7px;color:#d5e0ec;text-decoration:none;font:400 .9rem/1.4 \"Segoe UI\",Arial,sans-serif}.ds-nav a:hover{background:#223e60;color:white}.ds-nav a[aria-current=page]{background:#254969;color:white;box-shadow:inset 0 0 0 1px #45647e}.ds-nav a:focus-visible{outline:3px solid white;outline-offset:3px}"
    },
    {
      "name": "Status badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Noninteractive written state; success example.",
