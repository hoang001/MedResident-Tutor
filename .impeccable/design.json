      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:5px;background:var(--success-soft,#edf7f2);color:var(--success,#176244);font:600 .8rem/1.6 \"Segoe UI\",Arial,sans-serif}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat grouped task surface.",
      "html": "<section class=\"ds-panel\"><h2>Tài liệu đối chiếu</h2><p>Đọc đoạn trích rồi gắn vào đúng tiêu chí.</p></section>",
      "css": ".ds-panel{padding:26px;background:var(--surface,#fff);color:var(--ink,#1c3049);border:1px solid var(--line,#d9e2ec);border-radius:12px;box-shadow:none;font:16px/1.6 \"Segoe UI\",Arial,sans-serif}.ds-panel h2{margin:0 0 16px;color:var(--navy,#142d4e);font:700 1.35rem/1.3 \"Source Sans 3\",\"Segoe UI\",Arial,sans-serif;letter-spacing:-.02em}.ds-panel p{margin:0;color:var(--muted,#5d6d80);max-width:75ch}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "panel",
